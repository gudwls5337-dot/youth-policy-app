{
  "name": "youth-ordinance-map",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "전국 지자체 청년 조례·청년정책 상황판",
  "scripts": {
    "collect:ordinances": "node scripts/snapshot-ordinances.mjs",
    "collect:definitions": "node scripts/extract-definitions.mjs",
    "collect:policies": "node scripts/snapshot-policies.mjs",
    "build": "node scripts/build-board.mjs && node scripts/build-policies.mjs && node scripts/build-compare.mjs && node scripts/build.mjs",
    "validate": "node scripts/validate.mjs",
    "validate:deep": "node scripts/validate.mjs --resample=40",
    "validate:loop": "node scripts/validate.mjs --loop=3600 --resample=15",
    "smoke": "node scripts/smoke.mjs",
    "check": "npm run validate && npm run smoke",
    "audit:prepare": "node scripts/audit-prepare.mjs 12",
    "audit:report": "node scripts/audit-report.mjs",
    "refresh": "npm run collect:policies && npm run build && npm run check",
    "deploy": "node scripts/deploy.mjs",
    "pwa": "node scripts/make-pwa.mjs"
  },
  "dependencies": {
    "jsdom": "^29.1.1"
  },
  "homepage": "https://gudwls5337-dot.github.io/youth-policy-app/",
  "repository": {
    "type": "git",
    "url": "https://github.com/gudwls5337-dot/youth-policy-app.git"
  }
}
