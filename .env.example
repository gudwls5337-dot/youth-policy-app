# youth-ordinance-map — 환경변수
# 이 파일을 복사해 `.env` 로 이름을 바꾸고 값을 채우세요.
#   cp .env.example .env
# .env 는 .gitignore 에 있습니다. 절대 커밋하지 마세요.

# ─────────────────────────────────────────────────────────────
# 온통청년 청년정책 API  (01·02·03 섹션용)
# 발급: https://www.data.go.kr/data/15143273/openapi.do
#       로그인 → 활용신청 → 승인(보통 즉시) → 마이페이지 > 오픈API > 인증키
#
# 인증키가 두 종류로 보일 수 있습니다. 둘 다 넣어두면 스크립트가 알아서 씁니다.
#   · 일반 인증키(Encoding) → URL 에 그대로 붙이는 값. %2B, %3D 같은 게 섞여 있음
#   · 일반 인증키(Decoding) → 원본 값. + = 같은 기호가 그대로 보임
# ─────────────────────────────────────────────────────────────

# data.go.kr 로 호출할 때 쓰는 값 (Decoding 키를 넣으세요)
DATA_GO_KR_SERVICE_KEY=

# 위 Encoding 키 (있으면 넣고, 없으면 비워두세요)
DATA_GO_KR_SERVICE_KEY_ENCODED=

# 온통청년에서 직접 발급받은 경우의 키 이름
# (youthcenter.go.kr 로그인 → 마이페이지 > OPEN API)
# 위 data.go.kr 키만 있으면 비워두어도 됩니다.
YOUTH_CENTER_API_KEY=


# ─────────────────────────────────────────────────────────────
# 아래는 기본값이 있어 비워두어도 동작합니다
# ─────────────────────────────────────────────────────────────

# 법제처 Open API 이용기관 코드. 인증 없이 test 로 열립니다.
LAW_GO_KR_OC=test

# 스냅샷 기준일. 비우면 오늘 날짜.
SNAPSHOT_DATE=

# API 호출 간격(ms). 공공 API 예의상 200 이하로 내리지 마세요.
REQUEST_DELAY_MS=250

# 온통청년 청년정책 API
ONTONG_POLICY_API_KEY=

# 온통청년 청년공간 API
ONTONG_SPACE_API_KEY=

# 법제처 자치법규 API
LAW_OPEN_API_KEY=